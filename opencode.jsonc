{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "aspire": {
      "type": "local",
      "command": [
        "aspire",
        "agent",
        "mcp"
      ],
      "enabled": true
    },
	"antd": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@ant-design/cli",
        "mcp"
      ],
      "enabled": true
    }
  }
}