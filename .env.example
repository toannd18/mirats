# ==============================================================================
# Mirats / AspireReact — Docker Compose environment template
# ==============================================================================
# Cách dùng:
#   cp .env.example .env
#   # Điền TẤT CẢ biến BẮT BUỘC (không có default) rồi chạy:
#   docker compose up -d --build
#
# Quy ước:
#   BẮT BUỘC = prod phải set, không có default an toàn — compose sẽ fail nếu thiếu (${VAR:?required}).
#   TÙY CHỌN = có default dev hợp lý, có thể để trống để dùng default.
#
# LƯU Ý QUAN TRỌNG — 2 loại admin RIÊNG BIỆT (không dùng chung):
#   5a INITIAL_ADMIN_*  = Admin ỨNG DỤNG Mirats (đăng nhập app, IsSuperUser) — tạo qua Keycloak Admin API + JIT
#   5b KC_BOOTSTRAP_*   = Admin KEYCLOAK MASTER (đăng nhập /admin console) — do image Keycloak tự xử lý
# ==============================================================================

# ------------------------------------------------------------------------------
# Postgres — Database chính
# ------------------------------------------------------------------------------
# TÙY CHỌN: tên DB
POSTGRES_DB=aspire-react-db
# TÙY CHỌN: user DB
POSTGRES_USER=postgres
# BẮT BUỘC (prod): password DB — KHÔNG có default prod, không commit secret thật.
#   Dev có thể tạm dùng "postgres" nhưng prod PHẢI đổi. Compose dùng ${POSTGRES_PASSWORD:?required}.
POSTGRES_PASSWORD=
# TÙY CHỌN: host port map 5432:5432
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis — Output cache (reference-data)
# ------------------------------------------------------------------------------
# BẮT BUỘC (prod): bật password ở compose prod (theo quyết định DOCKER-1 #3).
#   Dev có thể để trống (= không auth). Prod PHẢI set.
REDIS_PASSWORD=
# TÙY CHỌN: host port map
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Keycloak — Realm & Clients
# ------------------------------------------------------------------------------
# TÙY CHỌN: tên realm — đồng bộ với backend Keycloak__Realm + frontend VITE_KEYCLOAK_REALM
KEYCLOAK_REALM=aspire-react
# TÙY CHỌN: public client cho frontend (keycloak-js)
KEYCLOAK_FRONTEND_CLIENT_ID=frontend
# TÙY CHỌN: confidential client cho backend
KEYCLOAK_BACKEND_CLIENT_ID=backend-service
# BẮT BUỘC (prod): secret của backend-service — KHÔNG default, không fallback.
#   Map vào Keycloak__ClientSecret backend + thay thế secret trong realm import.
KEYCLOAK_BACKEND_CLIENT_SECRET=
# TÙY CHỌN: tên nhóm/role trên Keycloak ánh xạ tới quyền Superuser trong app.
#   Backend (JitUserProvisioningService) đọc realm role này từ token JWT lúc
#   đăng nhập — nếu user thuộc role này, IsSuperUser=true được gán tự động.
#   Chỉ cần đổi nếu bạn đặt tên role khác trên Keycloak realm của mình.
KEYCLOAK_SUPERUSER_GROUP_NAME=superuser
# TÙY CHỌN: base URL Keycloak — 2 ĐƯỜNG KHÁC NHAU (không dùng chung 1 biến):
#   - KEYCLOAK_INTERNAL_URL (server → keycloak nội bộ Docker network): PHẢI là
#     http://keycloak:8080 (tên service), vì `start-dev` chỉ HTTP. Nếu là https sẽ
#     fail khi backend fetch JWKS (Authority mismatch) → JWT 401.
#   - KEYCLOAK_PUBLIC_URL (browser → keycloak qua cổng expose host): PHẢI dùng
#     localhost:<KEYCLOAK_PORT> (không vào Docker network), http cho dev start-dev.
# Backend: Keycloak__Authority = ${KEYCLOAK_INTERNAL_URL}/realms/${KEYCLOAK_REALM}
# Frontend: VITE_KEYCLOAK_URL = ${KEYCLOAK_PUBLIC_URL}
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# TÙY CHỌN: host port map cho Keycloak
KEYCLOAK_PORT=8080

# ------------------------------------------------------------------------------
# Backend API — aspire-react.Server
# ------------------------------------------------------------------------------
# TÙY CHỌN: Kestrel listen — Dockerfile prod fix về 5000 (đã sửa mismatch 5000 vs 5428/7314)
ASPNETCORE_URLS=http://+:5000
# TÙY CHỌN: Development chỉ cho dev (Aspire), prod để Production
ASPNETCORE_ENVIRONMENT=Production
# BẮT BUỘC (compose tự set từ POSTGRES_*): connection string Postgres — có thể override nếu cần
# ConnectionStrings__aspire-react-db=Host=postgres;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
# BẮT BUỘC (compose tự set): Redis connection string
# ConnectionStrings__cache=redis:6379,password=${REDIS_PASSWORD}
# Suy ra từ KEYCLOAK_* — DOCKER-4 phải dựng đủ (compose env) — không bỏ sót:
#   Keycloak__Authority          = ${KEYCLOAK_INTERNAL_URL}/realms/${KEYCLOAK_REALM}
#   Keycloak__ServerUrl          = ${KEYCLOAK_INTERNAL_URL}  (Admin API — khác Authority; thêm DOCKER re-verify 2026-08-24)
#   Keycloak__Realm              = ${KEYCLOAK_REALM}
#   Keycloak__ClientId           = ${KEYCLOAK_BACKEND_CLIENT_ID}
#   Keycloak__ClientSecret       = ${KEYCLOAK_BACKEND_CLIENT_SECRET}
#   Keycloak__SuperUserGroupName = ${KEYCLOAK_SUPERUSER_GROUP_NAME}
#   (có thể override riêng từng biến nếu cần)
# ConnectionStrings__aspire-react-db = Host=postgres;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
# ConnectionStrings__cache           = redis:6379,password=${REDIS_PASSWORD}  (hoặc redis:6379 nếu trống)
# VITE_KEYCLOAK_URL                  = ${KEYCLOAK_PUBLIC_URL}     (build arg frontend — browser dùng host URL)
# VITE_KEYCLOAK_REALM                = ${KEYCLOAK_REALM}          (build arg frontend)
# VITE_KEYCLOAK_CLIENT_ID            = ${KEYCLOAK_FRONTEND_CLIENT_ID} (build arg frontend)

# BẮT BUỘC (prod): CORS allowed origins — thay thế hard-code http://localhost:5173 trong Program.cs
#   Dạng CSV. Prod placeholder theo quyết định DOCKER-1 #2: https://app.example.com
#   Dev có thể để http://localhost:5173
CORS_ALLOWED_ORIGINS=https://app.example.com
# TÙY CHỌN: frontend URL dùng để sinh redirectUris/webOrigins trong realm (nếu template)
FRONTEND_URL=https://app.example.com

# ------------------------------------------------------------------------------
# Frontend — Vite build-time (VITE_* được bake vào bundle lúc build)
# ------------------------------------------------------------------------------
# TÙY CHỌN: base URL của SERVER (không gồm /api/v1 — frontend tự nối thêm).
#   - Prod (cùng origin qua Nginx): để /api/v1 là ĐÚNG — api-client chỉ nối /api/v1
#     thêm nếu base chưa kết thúc bằng /api/v1 (đã fix double-path DOCKER-8).
#   - Dev: http://localhost:5428 (proxy Vite tới API).
VITE_API_BASE_URL=/api/v1
# Suy ra từ KEYCLOAK_PUBLIC_URL:
# VITE_KEYCLOAK_URL=http://localhost:8080
# Suy ra từ KEYCLOAK_REALM:
# VITE_KEYCLOAK_REALM=aspire-react
# Suy ra từ KEYCLOAK_FRONTEND_CLIENT_ID:
# VITE_KEYCLOAK_CLIENT_ID=frontend

# ------------------------------------------------------------------------------
# Cổng host → container (prod)
# ------------------------------------------------------------------------------
# TÙY CHỌN: backend host port (container 5000)
BACKEND_PORT=5000
# TÙY CHỌN: frontend host port (container 80 via Nginx)
FRONTEND_PORT=80

# ------------------------------------------------------------------------------
# Debug profile — pgAdmin (chỉ khi --profile debug)
# ------------------------------------------------------------------------------
# TÙY CHỌN (debug): pgAdmin login — KHÔNG dùng chung POSTGRES_PASSWORD.
#   Chỉ có tác dụng khi chạy `docker compose --profile debug up -d`.
PGADMIN_DEFAULT_EMAIL=pgadmin@example.com
PGADMIN_PASSWORD=
PGADMIN_PORT=5050

# ==============================================================================
# SEED TÀI KHOẢN KHỞI TẠO LẦN ĐẦU — 2 LOẠI RIÊNG BIỆT
# ==============================================================================

# ------------------------------------------------------------------------------
# 5a. Admin ỨNG DỤNG Mirats (IsSuperUser=true) — đăng nhập app
# ------------------------------------------------------------------------------
# BẮT BUỘC, KHÔNG có default — người dùng PHẢI điền trước lần `docker compose up` đầu tiên.
#   Seed script sẽ tạo user này qua Keycloak Admin API (phương án A), JIT tự tạo bản ghi
#   local `User` với IsSuperUser khi đăng nhập lần đầu (đúng quy ước local_user_id).
#   KHÔNG hard-code Admin123! cho prod.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 5b. Admin KEYCLOAK MASTER (realm `master`) — đăng nhập /admin console
# ------------------------------------------------------------------------------
# BẮT BUỘC, KHÔNG có default, HOÀN TOÀN ĐỘC LẬP với 5a (không trùng username/password).
#   Image quay.io/keycloak/keycloak:26.6 đã hỗ trợ sẵn KC_BOOTSTRAP_ADMIN_* — chỉ map biến,
#   không tự viết seed logic. Chỉ có tác dụng lần đầu khi volume keycloak-data rỗng.
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
