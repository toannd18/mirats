# ==============================================================================
# Mirats / AspireReact — Docker Compose environment template
# ==============================================================================
# Cách dùng:
#   cp .env.example .env
#   # Điền TẤT CẢ biến BẮT BUỘC (không có default) rồi chạy:
#   docker compose up -d --build
#
# Quy ước:
#   BẮT BUỘC = prod phải set, không có default an toàn — compose sẽ fail nếu thiếu (${VAR:?required}).
#   TÙY CHỌN = có default dev hợp lý, có thể để trống để dùng default.
#
# [FIX-DEPLOY 2026-10-02] Auth là LOCAL (JWT tự ký HS256 + passkey tùy chọn) — Keycloak đã bị xóa
# hoàn toàn ở AUTH Phase 5. Mọi biến KEYCLOAK_*/KC_BOOTSTRAP_* và VITE_KEYCLOAK_* đã được dọn.
# Admin đầu tiên được server TỰ TẠO lúc khởi động (StartupDataSeeder) từ AUTH_BOOTSTRAP_ADMIN_PASSWORD
# — không cần chạy script seed riêng sau khi `up`.
# ==============================================================================

# ------------------------------------------------------------------------------
# Postgres — Database chính
# ------------------------------------------------------------------------------
# TÙY CHỌN: tên DB
POSTGRES_DB=aspire-react-db
# TÙY CHỌN: user DB
POSTGRES_USER=postgres
# BẮT BUỘC (prod): password DB — KHÔNG có default prod, không commit secret thật.
#   Dev có thể tạm dùng "postgres" nhưng prod PHẢI đổi. Compose dùng ${POSTGRES_PASSWORD:?required}.
POSTGRES_PASSWORD=
# TÙY CHỌN: host port map (prod KHÔNG map 5432; chỉ dùng khi debug cục bộ)
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis — Output cache (reference-data)
# ------------------------------------------------------------------------------
# BẮT BUỘC (prod): bật password ở compose prod (theo quyết định DOCKER-1 #3).
#   Dev có thể để trống (= không auth). Prod PHẢI set.
REDIS_PASSWORD=
# TÙY CHỌN: host port map
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# AUTH LOCAL — JWT tự ký (AUTH Phase 5; Keycloak đã xóa hoàn toàn)
# ------------------------------------------------------------------------------
# BẮT BUỘC: khóa ký HS256, tối thiểu 256 bit = **32 byte UTF-8** (server đo đúng cách dùng khóa
#   và **fail-fast khi khởi động** nếu ngắn hơn). KHÔNG commit giá trị thật. Sinh ví dụ:
#   openssl rand -base64 48
#   Đổi khóa này = mọi access token đã cấp bị vô hiệu (refresh token vẫn dùng được tới khi hết hạn).
AUTH_SIGNING_KEY=
# TÙY CHỌN: issuer/audience của token tự ký. Chỉ đổi khi bạn có lý do đặc biệt —
#   phải khớp giữa lúc cấp và lúc validate (cùng process nên chỉ cần set ở đây).
AUTH_ISSUER=aspire-react
AUTH_AUDIENCE=aspire-react-api
# BẮT BUỘC: mật khẩu của admin ĐẦU TIÊN (local auth, không có default, không fallback Admin123!).
#   Chỉ dùng MỘT LẦN khi tạo user admin trên DB trắng; đã có hash rồi thì giá trị này bị bỏ qua.
#   [READY GĐ0] Khi tạo admin trên DB trắng: phải **≥ 12 ký tự** và **khác INITIAL_ADMIN_USERNAME**
#   (server fail-fast nếu không đạt). Ưu tiên mật khẩu mạnh + đổi ngay sau lần đăng nhập đầu.
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# TÙY CHỌN: định danh admin đầu tiên (chỉ dùng khi user CHƯA tồn tại).
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@localhost

# ------------------------------------------------------------------------------
# Backup (service `backup` — mã hóa bằng age PUBLIC key)
# ------------------------------------------------------------------------------
# BẮT BUỘC: age public key (age1...). Sinh TRÊN MÁY ADMIN: `age-keygen -o backup-key.txt`.
#   KHÔNG copy private key (AGE-SECRET-KEY-...) lên server; mất private key = không khôi phục được.
BACKUP_AGE_RECIPIENT=
# TÙY CHỌN: lịch chạy hằng ngày (mặc định 01:00 giờ VN) + retention.
BACKUP_TIMEZONE=Asia/Ho_Chi_Minh
BACKUP_SCHEDULE_HOUR=1
BACKUP_SCHEDULE_MINUTE=0
BACKUP_RETENTION_DAYS=30
# TÙY CHỌN: thư mục host chứa bản backup + last_success (Zabbix đọc file này).
BACKUP_HOST_DIR=./backup-data
# TÙY CHỌN: copy ngoài máy (rsync/scp) — MẶC ĐỊNH TẮT (để trống).
#   VD: BACKUP_REMOTE=backup@10.0.0.5:/srv/mirats-backups
BACKUP_REMOTE=
# TÙY CHỌN: đường dẫn SSH private key BÊN TRONG container khi bật BACKUP_REMOTE.
BACKUP_REMOTE_SSH_KEY=

# ------------------------------------------------------------------------------
# Backend API — aspire-react.Server
# ------------------------------------------------------------------------------
# TÙY CHỌN: Kestrel listen — Dockerfile prod fix về 5000 (đã sửa mismatch 5000 vs 5428/7314)
ASPNETCORE_URLS=http://+:5000
# TÙY CHỌN: Development chỉ cho dev (Aspire), prod để Production
ASPNETCORE_ENVIRONMENT=Production
# BẮT BUỘC (compose tự set từ POSTGRES_*): connection string Postgres — có thể override nếu cần
# ConnectionStrings__aspire-react-db=Host=postgres;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
# BẮT BUỘC (compose tự set): Redis connection string
# ConnectionStrings__cache=redis:6379,password=${REDIS_PASSWORD}
# Suy ra từ AUTH_* (compose set trực tiếp, không cần khai báo thêm):
#   Auth__SigningKey              = ${AUTH_SIGNING_KEY}
#   Auth__Issuer                  = ${AUTH_ISSUER}
#   Auth__Audience                = ${AUTH_AUDIENCE}
#   Auth__BootstrapAdminPassword  = ${AUTH_BOOTSTRAP_ADMIN_PASSWORD}
#   INITIAL_ADMIN_USERNAME/EMAIL  = ${INITIAL_ADMIN_USERNAME}/${INITIAL_ADMIN_EMAIL}

# BẮT BUỘC (prod): CORS allowed origins — thay thế hard-code http://localhost:5173 trong Program.cs
#   Dạng CSV. Prod placeholder theo quyết định DOCKER-1 #2: https://app.example.com
#   Dev có thể để http://localhost:5173
CORS_ALLOWED_ORIGINS=https://app.example.com

# ------------------------------------------------------------------------------
# Frontend — Vite build-time (VITE_* được bake vào bundle lúc build)
# ------------------------------------------------------------------------------
# TÙY CHỌN: base URL của SERVER (không gồm /api/v1 — frontend tự nối thêm).
#   - Prod (cùng origin qua Nginx): để /api/v1 là ĐÚNG — api-client chỉ nối /api/v1
#     thêm nếu base chưa kết thúc bằng /api/v1 (đã fix double-path DOCKER-8).
#   - Dev: http://localhost:5428 (proxy Vite tới API).
VITE_API_BASE_URL=/api/v1

# Origin công khai dùng trong QR tem tài sản (không dấu / cuối). Dev có thể để trống
# để fallback window.location.origin; prod set domain thật và rebuild frontend.
VITE_PUBLIC_APP_URL=

# ------------------------------------------------------------------------------
# Cổng host → container (prod)
# ------------------------------------------------------------------------------
# TÙY CHỌN: backend host port (container 5000)
BACKEND_PORT=5000
# TÙY CHỌN: frontend host port (container 80 via Nginx)
FRONTEND_PORT=80

# ------------------------------------------------------------------------------
# Debug overlay — pgAdmin (docker-compose.debug.yml)
# ------------------------------------------------------------------------------
# BẮT BUỘC khi dùng overlay debug: mật khẩu pgAdmin — KHÔNG dùng chung POSTGRES_PASSWORD.
#   [READY GĐ0/GĐ2] pgAdmin đã tách khỏi docker-compose.yml; production KHÔNG cần biến này.
#   Chỉ cần set khi chạy:
#     docker compose -f docker-compose.yml -f docker-compose.debug.yml up -d pgadmin
PGADMIN_DEFAULT_EMAIL=pgadmin@example.com
PGADMIN_PASSWORD=
PGADMIN_PORT=5050

# ------------------------------------------------------------------------------
# Reverse proxy (NPM) + WebAuthn — CHỈ khi dùng docker-compose.npm.yml
# Mô hình: NPM (TLS) → mirats-frontend:80 → nginx → server:5000. Chỉ frontend join mạng NPM;
# server/postgres/redis/backup chỉ ở mạng nội bộ Mirats; KHÔNG publish cổng ra host.
# Xem DEPLOYMENT.md mục "Kết nối NPM".
# ------------------------------------------------------------------------------
# BẮT BUỘC: tên network external của NPM (docker network ls trên host NPM).
NPM_NETWORK=
# TÙY CHỌN: tên mạng nội bộ Mirats (mặc định mirats-internal).
MIRATS_NETWORK=mirats-internal
# BẮT BUỘC: CSV CIDR của CẢ HAI mạng proxy — mạng nội bộ Mirats + mạng NPM.
# Lấy subnet: docker network inspect <tên> -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# VD: 172.20.0.0/16,172.21.0.0/16. Fail-closed nếu để trống.
PROXY_KNOWN_NETWORKS=
# Số hop proxy: NPM + frontend nginx = 2 (đủ để lấy IP thật với XFF "client, NPM").
PROXY_FORWARD_LIMIT=2
# CHỈ true khi NPM chỉ nhận qua Cloudflare Tunnel (có firewall). Mặc định false.
PROXY_TRUST_CLOUDFLARE=false
# BẮT BUỘC: WebAuthn RP/origin theo domain nội bộ HTTPS thật.
# VD: WEBAUTHN_RPID=mirats.internal ; WEBAUTHN_ORIGINS=https://mirats.internal
WEBAUTHN_RPID=
WEBAUTHN_ORIGINS=
